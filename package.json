{
  "name": "mohs",
  "version": "0.1.0",
  "description": "MOHs · My Own Harness System — harness leve para agentes de código",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanSantos/MOHs.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mohs": "./bin/mohs.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "mohs": "node src/cli.ts",
    "demo": "node src/cli.ts climb --crew fake --cwd gym/demo",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "validate": "node gym/validation/validate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
